# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://dvl_user:your_password@localhost:5432/dvl_dashboard"

# ─── NextAuth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_SECRET"

# Your production URL (no trailing slash)
NEXTAUTH_URL="https://dvl.ifhe.edu.in"

# ─── Resend (Email) ──────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"

# From address (must be a verified domain in Resend)
EMAIL_FROM="DVL Dashboard <noreply@dvl.ifhe.edu.in>"

# ─── Google APIs (optional – for Drive integration) ──────────────
# Create a service account at https://console.cloud.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Root Google Drive folder where team folders are created
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# ─── App ─────────────────────────────────────────────────────────
NODE_ENV="production"
